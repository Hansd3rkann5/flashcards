# Optional: absolute API base URL for browser requests (used by src/lib/api.ts).
# Leave empty in dev to use Vite proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: backend target for Vite dev proxy.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: direct Supabase fallback for subjects when /api/subjects is empty.
# Uses same `records` table shape as legacy app.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
# VITE_SUPABASE_TABLE=records
